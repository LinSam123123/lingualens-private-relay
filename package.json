{
  "name": "lingualens",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-jade/lingualens.git"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "audit:repository": "node scripts/audit-repository.mjs --privacy",
    "test:repository-audit": "node --test tests/repository-audit.test.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "pack:firefox-unlisted": "node scripts/pack-firefox-unlisted.mjs",
    "amo-build": "node scripts/amo-build.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.mjs",
    "test:cache": "node --experimental-strip-types --test tests/cache.test.mjs",
    "test:storage-access": "node --experimental-strip-types --test tests/storage-access.test.mjs",
    "test:side-panel": "node --experimental-strip-types --test tests/side-panel.test.mjs",
    "test:credential-idb": "node --experimental-strip-types --test tests/credential-idb.test.mjs",
    "test:relay": "node --experimental-strip-types --test tests/relay.test.mjs",
    "test:relay-stream": "node --experimental-strip-types --test tests/relay-stream.test.mjs",
    "test:relay-adapter-stream": "node --experimental-strip-types --test tests/relay-adapter-stream.test.mjs",
    "test:fast-mode": "node --experimental-strip-types --test tests/fast-mode.test.mjs",
    "test:stream-delivery": "node --experimental-strip-types --test tests/stream-delivery.test.mjs",
    "test:engine-task": "node --experimental-strip-types --test tests/engine-task.test.mjs",
    "test:batch-chain": "node --experimental-strip-types --test tests/batch-chain.test.mjs",
    "test:page-write-attempt": "node --experimental-strip-types --test tests/page-write-attempt.test.mjs",
    "test:scheduler": "node --experimental-strip-types --test tests/scheduler.test.mjs",
    "test:scheduler-stream": "node --experimental-strip-types --test --test-concurrency=1 tests/scheduler-stream.test.mjs",
    "test:page-engine": "node --experimental-strip-types --test tests/page-engine.test.mjs",
    "test:batch-diagnostics": "node --experimental-strip-types --test tests/batch-diagnostics.test.mjs",
    "test:batching-metrics": "node --experimental-strip-types --test tests/batching-metrics.test.mjs",
    "test:mock-relay": "node scripts/mock-relay.mjs --self-test",
    "test:build-audit": "node --test tests/build-audit.test.mjs",
    "test:dynamic": "node --experimental-strip-types --test tests/node-revisions.test.mjs tests/dynamic-observer.test.mjs tests/dynamic-engine.test.mjs tests/auto-pages.test.mjs",
    "test": "npm run test:repository-audit && npm run test:security && npm run test:cache && npm run test:relay && npm run test:relay-stream && npm run test:relay-adapter-stream && npm run test:fast-mode && npm run test:stream-delivery && npm run test:engine-task && npm run test:batch-chain && npm run test:page-write-attempt && npm run test:scheduler && npm run test:scheduler-stream && npm run test:page-engine && npm run test:batch-diagnostics && npm run test:batching-metrics && npm run test:storage-access && npm run test:side-panel && npm run test:credential-idb && npm run test:mock-relay && npm run test:build-audit && npm run test:dynamic",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:build:firefox": "node scripts/audit-build.mjs firefox",
    "verify:firefox": "npm test && tsc --noEmit && npm run build:firefox && npm run audit:build:firefox",
    "verify": "npm test && tsc --noEmit && npm run build && npm run audit:build",
    "mock-relay": "node scripts/mock-relay.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "i18next": "^26.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
