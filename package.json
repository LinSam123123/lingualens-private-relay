{
  "name": "lingualens",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/q-jade/lingualens.git"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "pack:firefox-unlisted": "node scripts/pack-firefox-unlisted.mjs",
    "amo-build": "node scripts/amo-build.mjs",
    "test:security": "node --experimental-strip-types --test tests/security.test.mjs",
    "test:storage-access": "node --experimental-strip-types --test tests/storage-access.test.mjs",
    "test:side-panel": "node --experimental-strip-types --test tests/side-panel.test.mjs",
    "test:credential-idb": "node --experimental-strip-types --test tests/credential-idb.test.mjs",
    "test:relay": "node --experimental-strip-types --test tests/relay.test.mjs",
    "test:relay-stream": "node --experimental-strip-types --test tests/relay-stream.test.mjs",
    "test:stream-delivery": "node --experimental-strip-types --test tests/stream-delivery.test.mjs",
    "test:scheduler": "node --experimental-strip-types --test tests/scheduler.test.mjs",
    "test:scheduler-stream": "node --experimental-strip-types --test --test-concurrency=1 tests/scheduler-stream.test.mjs",
    "test:page-engine": "node --experimental-strip-types --test tests/page-engine.test.mjs",
    "test:batch-diagnostics": "node --experimental-strip-types --test tests/batch-diagnostics.test.mjs",
    "test:batching-metrics": "node --experimental-strip-types --test tests/batching-metrics.test.mjs",
    "test:mock-relay": "node scripts/mock-relay.mjs --self-test",
    "test": "npm run test:security && npm run test:relay && npm run test:relay-stream && npm run test:stream-delivery && npm run test:scheduler && npm run test:scheduler-stream && npm run test:page-engine && npm run test:batch-diagnostics && npm run test:batching-metrics && npm run test:storage-access && npm run test:side-panel && npm run test:credential-idb && npm run test:mock-relay",
    "audit:build": "node scripts/audit-build.mjs",
    "verify": "npm test && tsc --noEmit && npm run build && npm run audit:build",
    "mock-relay": "node scripts/mock-relay.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "i18next": "^26.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "wxt": "^0.20.26"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
